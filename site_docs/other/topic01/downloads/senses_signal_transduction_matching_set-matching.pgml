## DESCRIPTION
## Match each of the following sensory transduction components with their corresponding functions in signaling.
## ENDDESCRIPTION
## KEYWORDS('sensory transduction components','functions in signaling')
## DBsubject('Cell Biology')
## DBchapter('')
## DBsection('')
## Date('2026-08-19')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserPopUp.pl',
    'parserUtils.pl',
    'PGgraders.pl',
    'PGcourse.pl'
);
our @ALPHABET = ('A' .. 'Z');

# ================================
# Full matching data
# ================================
%match_data = (
  'Olfactory receptor (GPCR)' => [
    'Receptor that binds odorants and activates G proteins',
    'GPCR that initiates olfactory signaling in sensory neurons',
    'Odorant-activated GPCR upstream of cAMP production',
  ],
  'G<sub>olf</sub>' => [
    'Olfactory G protein that activates adenylyl cyclase',
    'G protein coupling olfactory receptors to cAMP signaling',
    'Heterotrimeric G protein used in olfactory GPCR pathways',
  ],
  'Adenylyl cyclase (AC3)' => [
    'Enzyme that converts ATP to cAMP in olfactory neurons',
    'Enzyme that produces cAMP as a second messenger',
    'ATP-to-cAMP enzyme downstream of G<sub>olf</sub>',
  ],
  'cAMP' => [
    'Second messenger made from ATP that rises during odor detection',
    'Signaling molecule that helps open olfactory CNG channels',
    'Cytosolic second messenger produced downstream of olfactory GPCRs',
  ],
  'CNG channel (olfactory)' => [
    'Ion channel opened by cyclic nucleotides during odor detection',
    'Cyclic nucleotide gated channel that depolarizes olfactory neurons',
    'Allows Ca<sup>2+</sup> entry that can amplify the olfactory response',
  ],
  'Gustducin' => [
    'Taste G protein used in bitter and sweet pathways',
    'G protein that couples taste GPCRs to downstream second messengers',
    'Heterotrimeric G protein in taste receptor signaling',
  ],
  'Phospholipase C-&beta;2 (PLC-&beta;2)' => [
    'Enzyme that cleaves PIP<sub>2</sub> to generate IP<sub>3</sub>',
    'PIP<sub>2</sub>-cleaving enzyme in bitter, sweet, and umami taste signaling',
    'Enzyme that produces IP<sub>3</sub> downstream of taste GPCRs',
  ],
  'IP<sub>3</sub>' => [
    'Second messenger that triggers Ca<sup>2+</sup> release from ER stores',
    'Diffusible messenger that raises cytosolic Ca<sup>2+</sup> in taste cells',
    'Molecule that opens IP<sub>3</sub> receptors on internal Ca<sup>2+</sup> stores',
  ],
  'TRPM5' => [
    'Cation channel activated downstream of Ca<sup>2+</sup> signaling in taste cells',
    'Channel that helps depolarize taste receptor cells after GPCR activation',
    'Ion channel involved in taste transduction downstream of IP<sub>3</sub>',
  ],
  'Rhodopsin' => [
    'Opsin plus retinal that activates transducin when retinal isomerizes',
    'Light-activated GPCR in rod photoreceptors',
    'Photopigment that starts rod phototransduction',
  ],
  'Transducin' => [
    'G protein that activates PDE6 in rod phototransduction',
    'Rod G protein linking rhodopsin to cGMP breakdown',
    'Heterotrimeric G protein in the visual cascade',
  ],
  'Phosphodiesterase 6 (PDE6)' => [
    'Enzyme that hydrolyzes cGMP in rods after light activation',
    'Enzyme that lowers cGMP concentration during phototransduction',
    'cGMP-degrading enzyme downstream of transducin',
  ],
  'cGMP' => [
    'Second messenger that keeps rod CNG channels open in the dark',
    'Signaling nucleotide that falls in light, closing CNG channels',
    'Cyclic nucleotide that gates rod outer segment ion channels',
  ],
  'CNG channel (rod outer segment)' => [
    'Ion channel that closes when cGMP falls, hyperpolarizing the rod',
    'cGMP-gated channel that is open in darkness and closes in light',
    'Rod channel controlled by cGMP levels',
  ],
  'Tip link (hair cell bundle)' => [
    'Mechanical tether that transmits force to open mechanotransduction channels',
    'Link between stereocilia that helps gate transduction channels',
    'Structure whose tension changes during stereocilia deflection',
  ],
  'Mechanotransduction channel (hair cell MET channel)' => [
    'Ion channel opened by stereocilia deflection in hearing and balance',
    'Mechanically gated channel that allows cation influx in hair cells',
    'Allows K<sup>+</sup> influx from K<sup>+</sup> rich endolymph to depolarize hair cells',
  ],
);

# -------------------------------
# Exclude pairs
# -------------------------------
@exclude_pairs = (
  ['cAMP', 'cGMP'],
  ['CNG channel (olfactory)', 'CNG channel (rod outer segment)'],
);

# -------------------------------
# Select N random keys
# -------------------------------
my $n = 8;
@all_keys = PGsort(sub { $_[0] lt $_[1] }, keys %match_data);
my $local_seed = (defined($problemSeed) && $problemSeed ne '') ? $problemSeed : 1;
my $local_random = new PGrandom($local_seed);

my @selected_keys = ();
my $max_tries = 500;
my $tries = 0;
while (1) {
  my @indices = (0 .. $#all_keys);
  my @shuffled = ();
  while (@indices) {
    my $pick = $local_random->random(0, $#indices, 1);
    push @shuffled, splice(@indices, $pick, 1);
  }
  @selected_keys = @all_keys[@shuffled[0..$n-1]];
  my %selected = map { $_ => 1 } @selected_keys;
  my $excluded = 0;
  foreach my $pair (@exclude_pairs) {
    my ($left, $right) = @$pair;
    if ($selected{$left} && $selected{$right}) {
      $excluded = 1;
      last;
    }
  }
  last if !$excluded;
  $tries += 1;
  if ($tries > $max_tries) {
    die 'Unable to find a non-conflicting set of keys';
  }
}

# -------------------------------
# Build question/answer pairs
# -------------------------------
# Each entry: [prompt, choice]
@q_and_a = ();
foreach my $key (@selected_keys) {
  my $values_ref = $match_data{$key};
  my $i = $local_random->random(0, $#$values_ref, 1);
  my $value = $values_ref->[$i];
  push @q_and_a, [ $value, $key ];
}

# -------------------------------
# Randomize the questions
# -------------------------------
my @q_indices = (0 .. $#q_and_a);
my @q_shuffled = ();
while (@q_indices) {
  my $pick = $local_random->random(0, $#q_indices, 1);
  push @q_shuffled, $q_and_a[splice(@q_indices, $pick, 1)];
}
@q_and_a = @q_shuffled;

# -------------------------------
# Sort the choices alphabetically
# -------------------------------
@answers = ();
push(@answers, (map { $_->[1] } @q_and_a));
@answers_sorted = PGsort(sub { $_[0] lt $_[1] }, @answers);

# -------------------------------
# HTML-safe answer labels
# -------------------------------
%answer_html = (
  'Olfactory receptor (GPCR)' => 'Olfactory receptor (GPCR)',
  'G<sub>olf</sub>' => 'G<sub>olf</sub>',
  'Adenylyl cyclase (AC3)' => 'Adenylyl cyclase (AC3)',
  'cAMP' => 'cAMP',
  'CNG channel (olfactory)' => 'CNG channel (olfactory)',
  'Gustducin' => 'Gustducin',
  'Phospholipase C-&beta;2 (PLC-&beta;2)' => 'Phospholipase C-&beta;2 (PLC-&beta;2)',
  'IP<sub>3</sub>' => 'IP<sub>3</sub>',
  'TRPM5' => 'TRPM5',
  'Rhodopsin' => 'Rhodopsin',
  'Transducin' => 'Transducin',
  'Phosphodiesterase 6 (PDE6)' => 'Phosphodiesterase 6 (PDE6)',
  'cGMP' => 'cGMP',
  'CNG channel (rod outer segment)' => 'CNG channel (rod outer segment)',
  'Tip link (hair cell bundle)' => 'Tip link (hair cell bundle)',
  'Mechanotransduction channel (hair cell MET channel)' => 'Mechanotransduction channel (hair cell MET channel)',
);

@answers_sorted_html = map { $answer_html{$_} || $_ } @answers_sorted;

# -------------------------------
# Create answer index lookup
# -------------------------------
our %answer_index;
for (my $i = 0; $i <= $#answers_sorted; $i++) {
  $answer_index{$answers_sorted[$i]} = $i;
}

# -------------------------------
# PopUp/DropDown compatibility
# -------------------------------
sub make_popup {
  return defined &DropDown ? DropDown(@_) : PopUp(@_);
}

# -------------------------------
# Create popup objects (blank default)
# -------------------------------
my @answer_letters = @ALPHABET[0 .. $#answers_sorted];
my @answer_letters_with_blank = ('', @answer_letters);
@answer_dropdowns =
  map { make_popup([ @answer_letters_with_blank ], $answer_index{$q_and_a[$_][1]} + 1 ) }
  0 .. $#q_and_a;

# -------------------------------
# Render the question
# -------------------------------
HEADER_TEXT(<<END_STYLE);
<style>
.two-column {
    display: flex;
	flex-wrap: wrap;
	gap: 2rem;
	align-items: center;
	justify-content: space-evenly;
}
</style>
END_STYLE

$question_text = 'Match each of the following sensory transduction components with their corresponding functions in signaling.';
$note_text = 'Note: Each choice will be used exactly once.';

BEGIN_PGML
[$question_text]*
[$note_text]*

[@ MODES(HTML => '<div class="two-column"><div>') @]*
[@ join(
    "\n\n",
    map {
        '[_]{$answer_dropdowns[' . $_ . ']} '
            . '*' . ($_ + 1) . '.* '
            . '[$q_and_a[' . $_ . '][0]]*'
    } 0 .. $#q_and_a
) @]**
[@ MODES(HTML => '</div><div class="right-col">') @]*
[@ join(
    "\n\n",
    map {
        chr(65 + $_) . '\\.' . ' ' . '[$answers_sorted_html[' . $_ . ']]*'
    } 0 .. $#answers_sorted
) @]**
[@ MODES(HTML => '</div></div>') @]*
END_PGML

# -------------------------------
# Dynamic Partial Credit Based on $n
# -------------------------------
$showPartialCorrectAnswers = 0;
my @thresholds;
my @scores;
for (my $i = 1; $i <= $n; $i++) {
  push @thresholds, $i;
  push @scores, sprintf("%.2f", $i / $n);
}

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{grader_numright} = [@thresholds];
$ENV{grader_scores}   = [@scores];
$ENV{grader_message} = 'You can earn partial credit.';

# -------------------------------
# Solution
# -------------------------------
$answer_list = join(', ', map { ($_ + 1) . '-' . $ALPHABET[$answer_index{$q_and_a[$_][1]}] } 0 .. $#q_and_a);
BEGIN_PGML_SOLUTION
The correct answers are: [$answer_list].
END_PGML_SOLUTION

ENDDOCUMENT();

