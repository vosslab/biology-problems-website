## DESCRIPTION
## Select the taste quality that corresponds to the given stimulus.
## ENDDESCRIPTION
## KEYWORDS('taste_basics','taste qualities','stimuli','which one','multiple choice')
## DBsubject('Cell Biology')
## DBchapter('')
## DBsection('')
## Date('2026-07-12')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserRadioButtons.pl',
    'PGcourse.pl',
