## TITLE('Cell Theory')
## DESCRIPTION
## Select the statement that is TRUE or FALSE about cell theory.
## ENDDESCRIPTION
## KEYWORDS('cell theory','true/false','multiple choice')
## DBsubject('Cell Biology')
## DBchapter('')
## DBsection('')
## Date('2026-08-19')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

#==========================================================
# AUTO-GENERATED GROUPS FROM YAML
#==========================================================

@true_groups = (
  [
    'All <span style="color: orangered; font-weight:700;">living things</span> are composed of <span style="color: mediumblue; font-weight:700;">cells</span>.',
