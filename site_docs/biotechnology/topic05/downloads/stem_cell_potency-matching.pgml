## DESCRIPTION
## Match each of the following potencies of stem cells with their corresponding descriptions.
## ENDDESCRIPTION
## KEYWORDS('potencies of stem cells','descriptions')
## DBsubject('Cell Biology')
## DBchapter('')
## DBsection('')
## Date('2026-11-18')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserPopUp.pl',
    'parserUtils.pl',
    'PGgraders.pl',
    'PGcourse.pl'
);
our @ALPHABET = ('A' .. 'Z');

# ================================
# Full matching data
# ================================
%match_data = (
  'unipotent' => [
    'can make just one kind of cell, as some stem cells in the outer layer of skin do',
    'can make only one kind of specialized cell, as stem cells that make sperm do',
    'can give rise to only one cell type, as in a stem cell that makes a single kind of skin cell',
    'can follow only one path as it develops, such as the path that leads to sperm',
    'has the smallest range and makes only one kind of specialized cell',
  ],
  'oligopotent' => [
    'can make only a few related kinds of cells, as some early blood cells do',
    'can make B cells, T cells, and NK cells, as an early cell in the lymphoid line can',
    'can make a few closely related cell types, such as a myeloid precursor making neutrophils and eosinophils',
  ],
  'multipotent' => [
    'can make many related cell types, as blood stem cells do in bone marrow or cord blood',
    'can make a range of related cell types, as mesenchymal stem cells do when they make bone, cartilage, or fat cells',
    'can make cells that form different tissues, such as bone, cartilage, and fat',
    'can make many related cell types to replace old or damaged cells in one tissue',
    'can give rise to many related types of specialized cells within a tissue or organ',
  ],
  'pluripotent' => [
    'can make cells from all three germ layers, as embryonic stem cells do',
    'can give rise to cell types from across the body, including nerve, muscle, and gut cells',
    'can stay unspecialized in the lab and later make cell types from all three germ layers',
  ],
  'totipotent' => [
    'can make all the cell types of the body and the placenta, as a fertilized egg can',
    'can form every kind of body cell plus the cells that help support the embryo',
    'can give rise to all the cells in an embryo as well as those in the placenta',
    'can make a whole embryo and the extra tissues it needs to grow',
  ],
);

# -------------------------------
# Select N random keys
# -------------------------------
my $n = 5;
@all_keys = PGsort(sub { $_[0] lt $_[1] }, keys %match_data);
my $local_seed = (defined($problemSeed) && $problemSeed ne '') ? $problemSeed : 1;
my $local_random = new PGrandom($local_seed);

my @indices = (0 .. $#all_keys);
my @shuffled = ();
while (@indices) {
  my $pick = $local_random->random(0, $#indices, 1);
  push @shuffled, splice(@indices, $pick, 1);
}
my @selected_keys = @all_keys[@shuffled[0..$n-1]];

# -------------------------------
# Build question/answer pairs
# -------------------------------
# Each entry: [prompt, choice]
@q_and_a = ();
foreach my $key (@selected_keys) {
  my $values_ref = $match_data{$key};
  my $i = $local_random->random(0, $#$values_ref, 1);
  my $value = $values_ref->[$i];
  push @q_and_a, [ $value, $key ];
}

# -------------------------------
# Randomize the questions
# -------------------------------
my @q_indices = (0 .. $#q_and_a);
my @q_shuffled = ();
while (@q_indices) {
  my $pick = $local_random->random(0, $#q_indices, 1);
  push @q_shuffled, $q_and_a[splice(@q_indices, $pick, 1)];
}
@q_and_a = @q_shuffled;

# -------------------------------
# Sort the choices alphabetically
# -------------------------------
@answers = ();
push(@answers, (map { $_->[1] } @q_and_a));
@answers_sorted = PGsort(sub { $_[0] lt $_[1] }, @answers);

# -------------------------------
# HTML-safe answer labels
# -------------------------------
%answer_html = (
  'unipotent' => '<span style="color: #b74300; font-weight:700;">unipotent</span>',
  'oligopotent' => '<span style="color: #3b7600; font-weight:700;">oligopotent</span>',
  'multipotent' => '<span style="color: #007576; font-weight:700;">multipotent</span>',
  'pluripotent' => '<span style="color: #0067cc; font-weight:700;">pluripotent</span>',
  'totipotent' => '<span style="color: #cc0066; font-weight:700;">totipotent</span>',
);

@answers_sorted_html = map { $answer_html{$_} || $_ } @answers_sorted;

# -------------------------------
# Create answer index lookup
# -------------------------------
our %answer_index;
for (my $i = 0; $i <= $#answers_sorted; $i++) {
  $answer_index{$answers_sorted[$i]} = $i;
}

# -------------------------------
# PopUp/DropDown compatibility
# -------------------------------
sub make_popup {
  return defined &DropDown ? DropDown(@_) : PopUp(@_);
}

# -------------------------------
# Create popup objects (blank default)
# -------------------------------
my @answer_letters = @ALPHABET[0 .. $#answers_sorted];
my @answer_letters_with_blank = ('', @answer_letters);
@answer_dropdowns =
  map { make_popup([ @answer_letters_with_blank ], $answer_index{$q_and_a[$_][1]} + 1 ) }
  0 .. $#q_and_a;

# -------------------------------
# Render the question
# -------------------------------
HEADER_TEXT(<<END_STYLE);
<style>
.pgml-bold { font-weight: 700; }
.two-column {
    display: flex;
	flex-wrap: wrap;
	gap: 2rem;
	align-items: center;
	justify-content: space-evenly;
}
</style>
END_STYLE

$question_text = 'Match each term with the range of cells a stem cell can make.';
$note_text = 'Note: Each choice will be used exactly once.';

BEGIN_PGML
[$question_text]*
[$note_text]*

[@ MODES(HTML => '<div class="two-column"><div>') @]*
[@ join(
    "\n\n",
    map {
        '[_]{$answer_dropdowns[' . $_ . ']} '
            . '*' . ($_ + 1) . '.* '
            . '[$q_and_a[' . $_ . '][0]]*'
    } 0 .. $#q_and_a
) @]**
[@ MODES(HTML => '</div><div class="right-col">') @]*
[@ join(
    "\n\n",
    map {
        chr(65 + $_) . '\\.' . ' ' . '[$answers_sorted_html[' . $_ . ']]*'
    } 0 .. $#answers_sorted
) @]**
[@ MODES(HTML => '</div></div>') @]*
END_PGML

# -------------------------------
# Dynamic Partial Credit Based on $n
# -------------------------------
$showPartialCorrectAnswers = 0;
my @thresholds;
my @scores;
for (my $i = 1; $i <= $n; $i++) {
  push @thresholds, $i;
  push @scores, sprintf("%.2f", $i / $n);
}

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{grader_numright} = [@thresholds];
$ENV{grader_scores}   = [@scores];
$ENV{grader_message} = 'You can earn partial credit.';

# -------------------------------
# Solution
# -------------------------------
$answer_list = join(', ', map { ($_ + 1) . '-' . $ALPHABET[$answer_index{$q_and_a[$_][1]}] } 0 .. $#q_and_a);
BEGIN_PGML_SOLUTION
The correct answers are: [$answer_list].
END_PGML_SOLUTION

ENDDOCUMENT();

