## DESCRIPTION
## Match each of the following gene-delivery vectors with their corresponding descriptions.
## ENDDESCRIPTION
## KEYWORDS('gene-delivery vectors','gene-delivery vectors','descriptions')
## DBsubject('Biotechnology')
## DBchapter('')
## DBsection('')
## Date('2026-11-18')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserPopUp.pl',
    'parserUtils.pl',
    'PGgraders.pl',
    'PGcourse.pl'
);
our @ALPHABET = ('A' .. 'Z');

# ================================
# Full matching data
# ================================
%match_data = (
  'adenoviral vector' => [
    'delivers double-stranded DNA and can make cells produce a lot of protein for a short time',
    'carries relatively large pieces of DNA, but an immune response can make repeat doses harder',
    'has a protein coat that can carry a large piece of DNA for strong, short-term expression',
    'can carry a large gene and its control sequences, but the immune response may shorten its effect',
    'can deliver a large DNA payload when the goal is to make a lot of protein briefly',
  ],
  'AAV vector' => [
    'carries a small piece of DNA that can stay outside chromosomes in cells that do NOT divide',
    'has room for about 4.7 kb of DNA, including the gene and its control sequences',
    'holds so little DNA that both the gene and its promoter must fit in a small space',
    'leaves much of its small DNA payload outside the chromosomes in cells that do NOT divide',
    'can keep a small gene active for a long time in cells that rarely divide',
    'can carry a small gene to cells in the retina, where the DNA can stay outside chromosomes',
  ],
  'retroviral vector' => [
    'makes a DNA copy of the RNA it carries and inserts the copy into a chromosome',
    'puts a gene into a chromosome so the cell can keep using it',
    q{copies RNA into DNA, then joins that DNA to one of the cell's chromosomes},
    'can pass an inserted gene to both daughter cells when a cell divides',
    'can keep a gene active by inserting it into a chromosome, but the insertion can disrupt another gene',
    'was used to add a working ADA gene to T cells in the early ADA-SCID trial',
  ],
  'lipid nanoparticle' => [
    'uses a small particle made of lipids to protect DNA or RNA',
    'packages RNA in a small particle that helps it enter cells without using a virus',
    'carries DNA or RNA in a particle made of lipids instead of a viral coat',
    'protects RNA in a tiny particle made of lipids while it travels to cells',
    'can carry RNA into a cell, but the RNA can get trapped in an endosome',
  ],
);

# -------------------------------
# Select N random keys
# -------------------------------
my $n = 4;
@all_keys = PGsort(sub { $_[0] lt $_[1] }, keys %match_data);
my $local_seed = (defined($problemSeed) && $problemSeed ne '') ? $problemSeed : 1;
my $local_random = new PGrandom($local_seed);

my @indices = (0 .. $#all_keys);
my @shuffled = ();
while (@indices) {
  my $pick = $local_random->random(0, $#indices, 1);
  push @shuffled, splice(@indices, $pick, 1);
}
my @selected_keys = @all_keys[@shuffled[0..$n-1]];

# -------------------------------
# Build question/answer pairs
# -------------------------------
# Each entry: [prompt, choice]
@q_and_a = ();
foreach my $key (@selected_keys) {
  my $values_ref = $match_data{$key};
  my $i = $local_random->random(0, $#$values_ref, 1);
  my $value = $values_ref->[$i];
  push @q_and_a, [ $value, $key ];
}

# -------------------------------
# Randomize the questions
# -------------------------------
my @q_indices = (0 .. $#q_and_a);
my @q_shuffled = ();
while (@q_indices) {
  my $pick = $local_random->random(0, $#q_indices, 1);
  push @q_shuffled, $q_and_a[splice(@q_indices, $pick, 1)];
}
@q_and_a = @q_shuffled;

# -------------------------------
# Sort the choices alphabetically
# -------------------------------
@answers = ();
push(@answers, (map { $_->[1] } @q_and_a));
@answers_sorted = PGsort(sub { $_[0] lt $_[1] }, @answers);

# -------------------------------
# HTML-safe answer labels
# -------------------------------
%answer_html = (
  'adenoviral vector' => '<span style="color: #935d00; font-weight:700;">adenoviral vector</span>',
  'AAV vector' => '<span style="color: #0067cc; font-weight:700;">AAV vector</span>',
  'retroviral vector' => '<span style="color: #a719db; font-weight:700;">retroviral vector</span>',
  'lipid nanoparticle' => '<span style="color: #00775f; font-weight:700;">lipid nanoparticle</span>',
);

@answers_sorted_html = map { $answer_html{$_} || $_ } @answers_sorted;

# -------------------------------
# Create answer index lookup
# -------------------------------
our %answer_index;
for (my $i = 0; $i <= $#answers_sorted; $i++) {
  $answer_index{$answers_sorted[$i]} = $i;
}

# -------------------------------
# PopUp/DropDown compatibility
# -------------------------------
sub make_popup {
  return defined &DropDown ? DropDown(@_) : PopUp(@_);
}

# -------------------------------
# Create popup objects (blank default)
# -------------------------------
my @answer_letters = @ALPHABET[0 .. $#answers_sorted];
my @answer_letters_with_blank = ('', @answer_letters);
@answer_dropdowns =
  map { make_popup([ @answer_letters_with_blank ], $answer_index{$q_and_a[$_][1]} + 1 ) }
  0 .. $#q_and_a;

# -------------------------------
# Render the question
# -------------------------------
HEADER_TEXT(<<END_STYLE);
<style>
.pgml-bold { font-weight: 700; }
.two-column {
    display: flex;
	flex-wrap: wrap;
	gap: 2rem;
	align-items: center;
	justify-content: space-evenly;
}
</style>
END_STYLE

$question_text = 'Match each carrier with its description.';
$note_text = 'Note: Each choice will be used exactly once.';

BEGIN_PGML
[$question_text]*
[$note_text]*

[@ MODES(HTML => '<div class="two-column"><div>') @]*
[@ join(
    "\n\n",
    map {
        '[_]{$answer_dropdowns[' . $_ . ']} '
            . '*' . ($_ + 1) . '.* '
            . '[$q_and_a[' . $_ . '][0]]*'
    } 0 .. $#q_and_a
) @]**
[@ MODES(HTML => '</div><div class="right-col">') @]*
[@ join(
    "\n\n",
    map {
        chr(65 + $_) . '\\.' . ' ' . '[$answers_sorted_html[' . $_ . ']]*'
    } 0 .. $#answers_sorted
) @]**
[@ MODES(HTML => '</div></div>') @]*
END_PGML

# -------------------------------
# Dynamic Partial Credit Based on $n
# -------------------------------
$showPartialCorrectAnswers = 0;
my @thresholds;
my @scores;
for (my $i = 1; $i <= $n; $i++) {
  push @thresholds, $i;
  push @scores, sprintf("%.2f", $i / $n);
}

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{grader_numright} = [@thresholds];
$ENV{grader_scores}   = [@scores];
$ENV{grader_message} = 'You can earn partial credit.';

# -------------------------------
# Solution
# -------------------------------
$answer_list = join(', ', map { ($_ + 1) . '-' . $ALPHABET[$answer_index{$q_and_a[$_][1]}] } 0 .. $#q_and_a);
BEGIN_PGML_SOLUTION
The correct answers are: [$answer_list].
END_PGML_SOLUTION

ENDDOCUMENT();

