## DESCRIPTION
## Select the technique that corresponds to the given description.
## ENDDESCRIPTION
## KEYWORDS('proteomics versus metabolomics','techniques','descriptions','which one','multiple choice')
## DBsubject('Biotechnology')
## DBchapter('')
## DBsection('')
## Date('2026-09-25')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserRadioButtons.pl',
    'PGcourse.pl',
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 0;

#==========================================================
# QUESTION DATA
#==========================================================

# All questions data
@questions_data = (
  {
    'item_name' => '<strong>studies the unique chemical fingerprints that cellular processes leave behind</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Metabolomics',
  },
  {
    'item_name' => '<strong>gives an instantaneous snapshot of the physiology of a cell</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Metabolomics',
  },
  {
    'item_name' => '<strong>studies the relative abundance of chemical intermediates and products of a cell</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Metabolomics',
  },
  {
    'item_name' => '<strong>studies the small molecules a cell uses and releases</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Metabolomics',
  },
  {
    'item_name' => '<strong>measures the pool of small molecules, usually under 1 kDa</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Metabolomics',
  },
  {
    'item_name' => '<strong>shows whether enzymes have changed the levels of those small molecules</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Metabolomics',
  },
  {
    'item_name' => '<strong>shows whether catalysts have changed the levels of the cell\'s small molecules</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Metabolomics',
  },
  {
    'item_name' => '<strong>studies the degradation rate of the gene products a cell has already made</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Proteomics',
  },
  {
    'item_name' => '<strong>studies the set of gene products being produced in a cell</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Proteomics',
  },
  {
    'item_name' => '<strong>studies the entire set of translated gene products made by an organism</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Proteomics',
  },
  {
    'item_name' => '<strong>measures when and where translated gene products accumulate</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Proteomics',
  },
  {
    'item_name' => '<strong>studies the rate at which a cell synthesizes its gene products</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Proteomics',
  },
  {
    'item_name' => '<strong>studies which enzymes are present and active</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Proteomics',
  },
  {
    'item_name' => '<strong>studies which biological catalysts are present and active</strong>',
    'plural_choice' => 'techniques',
    'singular_item' => 'description',
    'choices' => [
      'Metabolomics',
      'Proteomics',
    ],
    'correct' => 'Proteomics',
  },
);

#==========================================================
# SELECT RANDOM QUESTION
#==========================================================

my $local_random = PGrandom->new();
$local_random->srand($problemSeed);

$question_idx = $local_random->random(0, scalar(@questions_data) - 1, 1);
$q = $questions_data[$question_idx];

$item_name = $q->{'item_name'};
$plural_choice = $q->{'plural_choice'};
$singular_item = $q->{'singular_item'};
@choices = @{ $q->{'choices'} };
$correct = $q->{'correct'};

#==========================================================
# SHUFFLE CHOICES (SEED-STABLE)
#==========================================================

my @choice_indices = (0 .. $#choices);
my @choice_shuffled = ();
while (@choice_indices) {
  my $pick = $local_random->random(0, $#choice_indices, 1);
  push @choice_shuffled, splice(@choice_indices, $pick, 1);
}
@choices = @choices[@choice_shuffled];

#==========================================================
# BUILD RADIO BUTTONS
#==========================================================

$rb = RadioButtons(
  [@choices],
  $correct,
  labels        => 'ABC',
  displayLabels => 1,
  randomize     => 0,
  separator     => '<div style="margin-bottom: 0.7em;"></div>',
);

#==========================================================
# PGML
#==========================================================

BEGIN_PGML

Which one of the following [$plural_choice]* corresponds to the [$singular_item]* [$item_name]*?

[_]{$rb}

END_PGML

BEGIN_PGML_SOLUTION

The correct answer is: [$correct]*

END_PGML_SOLUTION

ENDDOCUMENT();

