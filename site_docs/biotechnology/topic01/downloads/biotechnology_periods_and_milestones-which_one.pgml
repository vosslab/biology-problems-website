## DESCRIPTION
## Select the historical biotechnology period that corresponds to the given milestone from that period.
## ENDDESCRIPTION
## KEYWORDS('biotechnology_periods_and_milestones','historical biotechnology periods','milestones from those periods','which one','multiple choice')
## DBsubject('Biotechnology')
## DBchapter('')
## DBsection('')
## Date('2026-09-25')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserRadioButtons.pl',
    'PGcourse.pl',
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 0;

#==========================================================
# QUESTION DATA
#==========================================================

# All questions data
@questions_data = (
  {
    'item_name' => '<strong>Selective cross-breeding of crops (about 10,000 BCE)</strong>',
