      'Modern times (1945-present)',
    ],
    'correct' => 'Ancient times (before 1800)',
  },
  {
    'item_name' => '<strong>Producing vinegar through fermentation (ancient practice)</strong>',
    'plural_choice' => 'historical biotechnology periods',
    'singular_item' => 'milestone from that period',
    'choices' => [
      'Ancient times (before 1800)',
      'Classical times (1800-1945)',
      'Modern times (1945-present)',
