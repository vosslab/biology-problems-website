## DESCRIPTION
## Match each of the following genes and genetic modifications with their corresponding functions.
## ENDDESCRIPTION
## KEYWORDS('genes and genetic modifications','functions')
## DBsubject('Biotechnology')
## DBchapter('')
## DBsection('')
## Date('2026-10-26')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserPopUp.pl',
    'parserUtils.pl',
    'PGgraders.pl',
    'PGcourse.pl'
);
our @ALPHABET = ('A' .. 'Z');

# ================================
# Full matching data
# ================================
%match_data = (
  'DREB1A gene' => [
    'Turns on genes that help plants respond to drought and other stresses',
    'Activates genes that help plants tolerate drought and other stresses',
    'Coordinates several genes involved in coping with water shortage',
  ],
  'Cry/Bt genes' => [
    'Produces a protein that damages the gut of susceptible insect larvae',
    'Produces a toxin that kills susceptible insect larvae when they eat the crop',
    'Makes a bacterial toxin that protects crops against certain insect pests',
  ],
  'AVP1 gene' => [
    'Produces a proton pump that helps store dissolved substances in plant vacuoles',
    'Produces a vacuolar proton pump that helps plants tolerate salt stress',
    'Increases proton pumping into vacuoles, helping plants retain water during salt stress',
  ],
  'Modified aroA gene' => [
    'Allows plants to keep making amino acids when treated with glyphosate',
    'Produces a form of EPSPS that still works in the presence of glyphosate',
    'Produces an enzyme that resists glyphosate, the herbicide sold as Roundup',
  ],
  'Modified ALS gene' => [
    'Allows plants to keep making amino acids when treated with sulfonylureas',
    'Produces an amino acid synthesis enzyme that resists sulfonylurea herbicides',
    'Keeps an amino acid synthesis pathway working in plants exposed to sulfonylureas',
  ],
  'Modified QB protein gene' => [
    'Allows photosynthesis to continue when plants are treated with atrazine',
    'Protects photosynthetic electron transport from being blocked by atrazine',
    'Reduces atrazine binding at its target in the photosynthetic machinery',
  ],
  'TMV coat protein gene' => [
    'Helps protect plants against infection by tobacco mosaic virus',
    'Gives plants resistance to the virus that causes tobacco mosaic disease',
    'Reduces disease caused by tobacco mosaic virus in susceptible plants',
  ],
  'Golden Rice genes' => [
    'Enable production of beta-carotene, a vitamin A precursor, in the grain',
    'Add enzymes that make a vitamin A precursor in the edible grain',
    'Increase beta-carotene in grain so it supplies a precursor of vitamin A',
  ],
  'gutD gene' => [
    'Helps maize build up sorbitol, a sugar alcohol linked to salt tolerance',
    'Increases sorbitol production in maize, which can help with salt tolerance',
    'Adds a bacterial enzyme that helps maize accumulate sorbitol during growth',
  ],
  'Human antibody genes' => [
    'Allow plants to make proteins that bind specific targets for medical use',
    'Turn plant cells into a source of proteins that bind disease targets',
    'Direct plants to produce immune-system proteins for use as medicines',
  ],
  'Antisense PG construct' => [
    'Reduces production of an enzyme that breaks down pectin in fruit cell walls',
    'Lowers the amount of a pectin-degrading enzyme made in ripening tomatoes',
    'Reduces pectin breakdown by lowering production of a fruit cell-wall enzyme',
  ],
);

# -------------------------------
# Select N random keys
# -------------------------------
my $n = 4;
@all_keys = PGsort(sub { $_[0] lt $_[1] }, keys %match_data);
my $local_seed = (defined($problemSeed) && $problemSeed ne '') ? $problemSeed : 1;
my $local_random = new PGrandom($local_seed);

my @indices = (0 .. $#all_keys);
my @shuffled = ();
while (@indices) {
  my $pick = $local_random->random(0, $#indices, 1);
  push @shuffled, splice(@indices, $pick, 1);
}
my @selected_keys = @all_keys[@shuffled[0..$n-1]];

# -------------------------------
# Build question/answer pairs
# -------------------------------
# Each entry: [prompt, choice]
@q_and_a = ();
foreach my $key (@selected_keys) {
  my $values_ref = $match_data{$key};
  my $i = $local_random->random(0, $#$values_ref, 1);
  my $value = $values_ref->[$i];
  push @q_and_a, [ $value, $key ];
}

# -------------------------------
# Randomize the questions
# -------------------------------
my @q_indices = (0 .. $#q_and_a);
my @q_shuffled = ();
while (@q_indices) {
  my $pick = $local_random->random(0, $#q_indices, 1);
  push @q_shuffled, $q_and_a[splice(@q_indices, $pick, 1)];
}
@q_and_a = @q_shuffled;

# -------------------------------
# Sort the choices alphabetically
# -------------------------------
@answers = ();
push(@answers, (map { $_->[1] } @q_and_a));
@answers_sorted = PGsort(sub { $_[0] lt $_[1] }, @answers);

# -------------------------------
# HTML-safe answer labels
# -------------------------------
%answer_html = (
  'DREB1A gene' => 'DREB1A gene',
  'Cry/Bt genes' => 'Cry/Bt genes',
  'AVP1 gene' => 'AVP1 gene',
  'Modified aroA gene' => 'Modified aroA gene',
  'Modified ALS gene' => 'Modified ALS gene',
  'Modified QB protein gene' => 'Modified QB protein gene',
  'TMV coat protein gene' => 'TMV coat protein gene',
  'Golden Rice genes' => 'Golden Rice genes',
  'gutD gene' => 'gutD gene',
  'Human antibody genes' => 'Human antibody genes',
  'Antisense PG construct' => 'Antisense PG construct',
);

@answers_sorted_html = map { $answer_html{$_} || $_ } @answers_sorted;

# -------------------------------
# Create answer index lookup
# -------------------------------
our %answer_index;
for (my $i = 0; $i <= $#answers_sorted; $i++) {
  $answer_index{$answers_sorted[$i]} = $i;
}

# -------------------------------
# PopUp/DropDown compatibility
# -------------------------------
sub make_popup {
  return defined &DropDown ? DropDown(@_) : PopUp(@_);
}

# -------------------------------
# Create popup objects (blank default)
# -------------------------------
my @answer_letters = @ALPHABET[0 .. $#answers_sorted];
my @answer_letters_with_blank = ('', @answer_letters);
@answer_dropdowns =
  map { make_popup([ @answer_letters_with_blank ], $answer_index{$q_and_a[$_][1]} + 1 ) }
  0 .. $#q_and_a;

# -------------------------------
# Render the question
# -------------------------------
HEADER_TEXT(<<END_STYLE);
<style>
.two-column {
    display: flex;
	flex-wrap: wrap;
	gap: 2rem;
	align-items: center;
	justify-content: space-evenly;
}
</style>
END_STYLE

$question_text = 'Match each of the following genes and genetic modifications with their corresponding functions.';
$note_text = 'Note: Each choice will be used exactly once.';

BEGIN_PGML
[$question_text]*
[$note_text]*

[@ MODES(HTML => '<div class="two-column"><div>') @]*
[@ join(
    "\n\n",
    map {
        '[_]{$answer_dropdowns[' . $_ . ']} '
            . '*' . ($_ + 1) . '.* '
            . '[$q_and_a[' . $_ . '][0]]*'
    } 0 .. $#q_and_a
) @]**
[@ MODES(HTML => '</div><div class="right-col">') @]*
[@ join(
    "\n\n",
    map {
        chr(65 + $_) . '\\.' . ' ' . '[$answers_sorted_html[' . $_ . ']]*'
    } 0 .. $#answers_sorted
) @]**
[@ MODES(HTML => '</div></div>') @]*
END_PGML

# -------------------------------
# Dynamic Partial Credit Based on $n
# -------------------------------
$showPartialCorrectAnswers = 0;
my @thresholds;
my @scores;
for (my $i = 1; $i <= $n; $i++) {
  push @thresholds, $i;
  push @scores, sprintf("%.2f", $i / $n);
}

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{grader_numright} = [@thresholds];
$ENV{grader_scores}   = [@scores];
$ENV{grader_message} = 'You can earn partial credit.';

# -------------------------------
# Solution
# -------------------------------
$answer_list = join(', ', map { ($_ + 1) . '-' . $ALPHABET[$answer_index{$q_and_a[$_][1]}] } 0 .. $#q_and_a);
BEGIN_PGML_SOLUTION
The correct answers are: [$answer_list].
END_PGML_SOLUTION

ENDDOCUMENT();

