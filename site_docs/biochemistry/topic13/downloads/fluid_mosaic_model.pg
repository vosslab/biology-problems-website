## TITLE('The Fluid Mosaic Model of Membrane Lipid Bilayers')
## DESCRIPTION
## Select the statement that is TRUE or FALSE about the fluid mosaic model of membrane lipid bilayers.
## ENDDESCRIPTION
## KEYWORDS('the fluid mosaic model of membrane lipid bilayers','true/false','multiple choice')
## DBsubject('Cell Biology')
## DBchapter('')
## DBsection('')
## Date('2026-07-12')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

#==========================================================
# AUTO-GENERATED GROUPS FROM YAML
#==========================================================

@true_groups = (
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is a <span style="color: #6c6c00; font-weight:700;">liquid</span>-like <span style="color: #b74300; font-weight:700;">structure</span>',
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> displays a <span style="color: #6c6c00; font-weight:700;">liquid</span>-like character.',
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is a <span style="color: #3b7600; font-weight:700;">flexible</span> barrier',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is composed of a variety of <span style="color: #a719db; font-weight:700;">lipids</span> and <span style="color: #076dad; font-weight:700;">proteins</span>.',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> separates the interior of the <span style="color: #007a00; font-weight:700;">cell</span> from the <span style="color: #c80085; font-weight:700;">external&nbsp;environment</span>',
  ],
);
@false_groups = (
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is a solid, <span style="color: #935d00; font-weight:700;">rigid</span> <span style="color: #b74300; font-weight:700;">structure</span>.',
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is a <span style="color: #935d00; font-weight:700;">rigid</span> barrier that separates the cytosol from the <span style="color: #c80085; font-weight:700;">external&nbsp;environment</span>',
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is a <span style="color: #935d00; font-weight:700;">rigid</span> <span style="color: #b74300; font-weight:700;">structure</span>.',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is composed of only <span style="color: #a719db; font-weight:700;">lipids</span>.',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> is composed of only <span style="color: #076dad; font-weight:700;">proteins</span>.',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> provides mechanical support to the <span style="color: #007a00; font-weight:700;">cell</span>',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> facilitates transport of molecules across the membrane',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> recognizes and binds to other <span style="color: #007a00; font-weight:700;">cell</span>s or substances',
  ],
  [
    'The <span style="color: #d40000; font-weight:700;">plasma&nbsp;membrane</span> provides energy to the <span style="color: #007a00; font-weight:700;">cell</span>',
  ],
);

#==========================================================
# GLOBAL SETTINGS
#==========================================================

$topic = 'the fluid mosaic model of membrane lipid bilayers';
my $local_random = PGrandom->new();
$local_random->srand($problemSeed);
my @mode_choices = ("TRUE", "FALSE");
$mode = $mode_choices[$local_random->random(0, $#mode_choices, 1)];
$num_distractors = 4;
#==========================================================
# SELECT GROUP
#==========================================================

my (@selected_group, @opposite_groups);

if ($mode eq "TRUE") {
  $group_index      = $local_random->random(0, scalar(@true_groups)-1, 1);
  @selected_group   = @{ $true_groups[$group_index] };
  @opposite_groups  = @false_groups;
} else {
  $group_index      = $local_random->random(0, scalar(@false_groups)-1, 1);
  @selected_group   = @{ $false_groups[$group_index] };
  @opposite_groups  = @true_groups;
}

#==========================================================
# PICK CORRECT + DISTRACTORS
#==========================================================

my $correct_index = $local_random->random(0, $#selected_group, 1);
$correct = $selected_group[$correct_index];

my @available_group_indices = (0 .. $#opposite_groups);
my @selected_distractor_indices = ();

while (@selected_distractor_indices < $num_distractors && @available_group_indices > 0) {
  my $random_index = $local_random->random(0, scalar(@available_group_indices)-1, 1);
  push @selected_distractor_indices, splice(@available_group_indices, $random_index, 1);
}

@distractors = ();
foreach my $group_idx (@selected_distractor_indices) {
  my @group = @{ $opposite_groups[$group_idx] };
  my $distractor_index = $local_random->random(0, $#group, 1);
  my $distractor = $group[$distractor_index];
  push @distractors, $distractor;
}

@choices = ($correct, @distractors);

#==========================================================
# SHUFFLE CHOICES (SEED-STABLE)
#==========================================================

my @choice_indices = (0 .. $#choices);
my @choice_shuffled = ();
while (@choice_indices) {
  my $pick = $local_random->random(0, $#choice_indices, 1);
  push @choice_shuffled, splice(@choice_indices, $pick, 1);
}
@choices = @choices[@choice_shuffled];

#==========================================================
# RADIO BUTTONS WITH A/B/C/D/E LABELS
#==========================================================

$rb = RadioButtons(
  [@choices],
  $correct,
  labels        => ['A','B','C','D','E'],
  displayLabels => 1,
  randomize     => 0,
  separator     => '<div style="margin-bottom: 0.7em;"></div>',
);

#==========================================================
# PGML
#==========================================================

BEGIN_PGML

[@ $mode eq "TRUE" ? "Which one of the following statements is <span style='color: #127663;'><strong>TRUE</strong></span> about $topic?" : "Which one of the following statements is <span style='color: #ba372a;'><strong>FALSE</strong></span> about $topic?" @]*

[_]{$rb}

END_PGML

ENDDOCUMENT();

