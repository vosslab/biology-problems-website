    'item_name' => '<strong>Traits from separate genes do NOT affect each other during the reproductive process.</strong>',
    'plural_choice' => q{Mendel's Foundational Principles of Genetics},
    'singular_item' => 'description',
    'choices' => [
      '<span style="color: #cc0066; font-weight:700;">Principle of Paired&nbsp;Factors</span>',
      '<span style="color: #b74300; font-weight:700;">Principle of Dominance</span>',
