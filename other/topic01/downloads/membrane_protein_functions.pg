## TITLE('Functions of Membrane&nbsp;proteins')
## DESCRIPTION
## Select the statement that is TRUE or FALSE about functions of membrane&nbsp;proteins.
## ENDDESCRIPTION
## KEYWORDS('functions of membrane&nbsp;proteins','true/false','multiple choice')
## DBsubject('Cell Biology')
## DBchapter('')
## DBsection('')
## Date('2026-07-12')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

#==========================================================
# AUTO-GENERATED GROUPS FROM YAML
#==========================================================

@true_groups = (
  [
    'They facilitate <span style="color: #007a00; font-weight:700;">transport</span> of <span style="color: #076dad; font-weight:700;">molecules</span> across the membrane',
    'They allow <span style="color: #b74300; font-weight:700;">passage</span> of hydrophilic <span style="color: #3b7600; font-weight:700;">substances</span> across the membrane',
    'They provide a hydrophilic channel for certain <span style="color: #076dad; font-weight:700;">molecules</span> or ions to use as a tunnel',
    'Some <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span> serve as channels, pumps, or receptors',
  ],
  [
    'They recognize and bind to other <span style="color: #935d00; font-weight:700;">cells</span> or <span style="color: #3b7600; font-weight:700;">substances</span>',
    'Carbohydrates covantly attached to <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span> allow <span style="color: #935d00; font-weight:700;">cells</span> to recognize eachother',
  ],
  [
    'They tightly attach the cytoskeleton to the extracellular matrix (ECM)',
    'Some <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span> anchor the cytoskeleton to the plasma membrane',
    'Some <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span> anchor the extracellular matrix (ECM) to the plasma membrane',
  ],
  [
    'They provide <span style="color: #c80085; font-weight:700;">enzymatic&nbsp;activity</span> for certain chemical reactions',
    'Some <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span> are <span style="color: #c80085; font-weight:700;">enzymes</span> that catalyze specific reactions',
  ],
  [
    'They receive <span style="color: #935d00; font-weight:700;">cell </span>signals and transduce them across the membrane',
    'Some <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span> binds to signaling <span style="color: #076dad; font-weight:700;">molecules</span> such as hormones or neurotransmitters',
  ],
  [
    'They create intercellular junctions between adjacent <span style="color: #935d00; font-weight:700;">cells</span>',
    'Some <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span> are repsonsible for attaching <span style="color: #935d00; font-weight:700;">cells</span> together',
  ],
);
@false_groups = (
  [
    'They prevent the <span style="color: #b74300; font-weight:700;">passage</span> of <span style="color: #935d00; font-weight:700;">hydrophobic</span> <span style="color: #3b7600; font-weight:700;">substances</span> across the membrane',
    'They block the <span style="color: #b74300; font-weight:700;">passage</span> of <span style="color: #935d00; font-weight:700;">hydrophobic</span> <span style="color: #076dad; font-weight:700;">molecules</span> from crossing the membrane',
  ],
  [
    'They are responsible for separating the interior of the <span style="color: #935d00; font-weight:700;">cell </span>from its external environment',
  ],
);

#==========================================================
# GLOBAL SETTINGS
#==========================================================

$topic = 'functions of <span style="color: #d40000; font-weight:700;">membrane&nbsp;proteins</span>';
my $local_random = PGrandom->new();
$local_random->srand($problemSeed);
my @mode_choices = ("TRUE", "FALSE");
$mode = $mode_choices[$local_random->random(0, $#mode_choices, 1)];
$num_distractors = 4;
#==========================================================
# SELECT GROUP
#==========================================================

my (@selected_group, @opposite_groups);

if ($mode eq "TRUE") {
  $group_index      = $local_random->random(0, scalar(@true_groups)-1, 1);
  @selected_group   = @{ $true_groups[$group_index] };
  @opposite_groups  = @false_groups;
} else {
  $group_index      = $local_random->random(0, scalar(@false_groups)-1, 1);
  @selected_group   = @{ $false_groups[$group_index] };
  @opposite_groups  = @true_groups;
}

#==========================================================
# PICK CORRECT + DISTRACTORS
#==========================================================

my $correct_index = $local_random->random(0, $#selected_group, 1);
$correct = $selected_group[$correct_index];

my @available_group_indices = (0 .. $#opposite_groups);
my @selected_distractor_indices = ();

while (@selected_distractor_indices < $num_distractors && @available_group_indices > 0) {
  my $random_index = $local_random->random(0, scalar(@available_group_indices)-1, 1);
  push @selected_distractor_indices, splice(@available_group_indices, $random_index, 1);
}

@distractors = ();
foreach my $group_idx (@selected_distractor_indices) {
  my @group = @{ $opposite_groups[$group_idx] };
  my $distractor_index = $local_random->random(0, $#group, 1);
  my $distractor = $group[$distractor_index];
  push @distractors, $distractor;
}

@choices = ($correct, @distractors);

#==========================================================
# SHUFFLE CHOICES (SEED-STABLE)
#==========================================================

my @choice_indices = (0 .. $#choices);
my @choice_shuffled = ();
while (@choice_indices) {
  my $pick = $local_random->random(0, $#choice_indices, 1);
  push @choice_shuffled, splice(@choice_indices, $pick, 1);
}
@choices = @choices[@choice_shuffled];

#==========================================================
# RADIO BUTTONS WITH A/B/C/D/E LABELS
#==========================================================

$rb = RadioButtons(
  [@choices],
  $correct,
  labels        => ['A','B','C','D','E'],
  displayLabels => 1,
  randomize     => 0,
  separator     => '<div style="margin-bottom: 0.7em;"></div>',
);

#==========================================================
# PGML
#==========================================================

BEGIN_PGML

[@ $mode eq "TRUE" ? "Which one of the following statements is <span style='color: #127663;'><strong>TRUE</strong></span> about $topic?" : "Which one of the following statements is <span style='color: #ba372a;'><strong>FALSE</strong></span> about $topic?" @]*

[_]{$rb}

END_PGML

ENDDOCUMENT();

