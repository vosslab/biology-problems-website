    'correct' => '<span style="color: #d40000; font-weight:700;">gene&nbsp;addition</span>',
  },
  {
    'item_name' => q{<strong>giving a patient's cells a working ADA gene in the lab</strong>},
    'plural_choice' => 'genetic treatment strategies',
    'singular_item' => 'description',
    'choices' => [
      '<span style="color: #d40000; font-weight:700;">gene&nbsp;addition</span>',
      '<span style="color: #b74300; font-weight:700;">genome&nbsp;editing</span>',
    ],
    'correct' => '<span style="color: #d40000; font-weight:700;">gene&nbsp;addition</span>',
  },
  {
    'item_name' => '<strong>using CRISPR to change one DNA letter at a chosen spot</strong>',
    'plural_choice' => 'genetic treatment strategies',
    'singular_item' => 'description',
    'choices' => [
      '<span style="color: #d40000; font-weight:700;">gene&nbsp;addition</span>',
      '<span style="color: #b74300; font-weight:700;">genome&nbsp;editing</span>',
    ],
    'correct' => '<span style="color: #b74300; font-weight:700;">genome&nbsp;editing</span>',
  },
  {
    'item_name' => q{<strong>removing HIV DNA that had become part of a cell's chromosome</strong>},
    'plural_choice' => 'genetic treatment strategies',
    'singular_item' => 'description',
    'choices' => [
      '<span style="color: #d40000; font-weight:700;">gene&nbsp;addition</span>',
      '<span style="color: #b74300; font-weight:700;">genome&nbsp;editing</span>',
    ],
