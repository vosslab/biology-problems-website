      '<span style="color: #d40000; font-weight:700;">gene&nbsp;addition</span>',
      '<span style="color: #b74300; font-weight:700;">genome&nbsp;editing</span>',
    ],
    'correct' => '<span style="color: #b74300; font-weight:700;">genome&nbsp;editing</span>',
