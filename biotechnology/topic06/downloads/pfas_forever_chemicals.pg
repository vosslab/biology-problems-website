## TITLE('PFAS, Also Called Forever Chemicals')
## DESCRIPTION
## Select the statement that is TRUE or FALSE about PFAS, also called forever chemicals.
## ENDDESCRIPTION
## KEYWORDS('PFAS, also called forever chemicals','true/false','multiple choice')
## DBsubject('Biotechnology')
## DBchapter('')
## DBsection('')
## Date('2026-11-18')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

#==========================================================
# AUTO-GENERATED GROUPS FROM YAML
#==========================================================

@true_groups = (
  [
    'PFAS are a family of chemicals',
    'the name PFAS covers many different chemicals',
  ],
  [
    'many PFAS take a long time to break down',
    'some PFAS stay in the environment for a long time',
    'the name forever chemicals refers to how slowly many PFAS break down',
  ],
  [
    'some PFAS have been used to make clothing resist water',
    'some PFAS have helped keep stains from sticking to carpet',
    'some PFAS have been used in nonstick cookware',
    'some food wrappers have used PFAS to resist grease',
  ],
  [
    'people can take in PFAS by drinking contaminated water',
    'eating food that contains PFAS can expose a person to them',
    'people can come into contact with PFAS at some workplaces',
  ],
  [
    'different PFAS can have different effects on health',
    'health risks depend partly on which PFAS a person takes in',
  ],
);
@false_groups = (
  [
    'PFAS is the name of a single chemical',
    'PFAS is another name for the element fluorine',
    'PFAS is the name of one brand of nonstick coating',
  ],
  [
    'PFAS in soil tend to break down within days',
    'PFAS are called forever chemicals because they kill germs',
    'PFAS are called forever chemicals because pans with PFAS last longer',
  ],
  [
    'PFAS have been added to rain jackets to soak up water',
    'PFAS have been added to food wrappers to soak up grease',
    'PFAS have been used to make oil stick to pans',
  ],
  [
    'exposure to PFAS is limited to workers who make them',
    'PFAS can enter the body through the lungs but NOT through the gut',
    'a person has to handle a product with PFAS to be exposed',
  ],
  [
    'different PFAS have the same health effects',
    'a small amount of a PFAS poses the same risk as a large amount',
    'knowing a chemical is a PFAS tells you exactly how harmful it is',
  ],
);

#==========================================================
# GLOBAL SETTINGS
#==========================================================

$topic = 'PFAS, also called forever chemicals';
my $local_random = PGrandom->new();
$local_random->srand($problemSeed);
my @mode_choices = ("TRUE", "FALSE");
$mode = $mode_choices[$local_random->random(0, $#mode_choices, 1)];
$num_distractors = 4;
#==========================================================
# SELECT GROUP
#==========================================================

my (@selected_group, @opposite_groups);

if ($mode eq "TRUE") {
  $group_index      = $local_random->random(0, scalar(@true_groups)-1, 1);
  @selected_group   = @{ $true_groups[$group_index] };
  @opposite_groups  = @false_groups;
} else {
  $group_index      = $local_random->random(0, scalar(@false_groups)-1, 1);
  @selected_group   = @{ $false_groups[$group_index] };
  @opposite_groups  = @true_groups;
}

#==========================================================
# PICK CORRECT + DISTRACTORS
#==========================================================

my $correct_index = $local_random->random(0, $#selected_group, 1);
$correct = $selected_group[$correct_index];

my @available_group_indices = (0 .. $#opposite_groups);
my @selected_distractor_indices = ();

while (@selected_distractor_indices < $num_distractors && @available_group_indices > 0) {
  my $random_index = $local_random->random(0, scalar(@available_group_indices)-1, 1);
  push @selected_distractor_indices, splice(@available_group_indices, $random_index, 1);
}

@distractors = ();
foreach my $group_idx (@selected_distractor_indices) {
  my @group = @{ $opposite_groups[$group_idx] };
  my $distractor_index = $local_random->random(0, $#group, 1);
  my $distractor = $group[$distractor_index];
  push @distractors, $distractor;
}

@choices = ($correct, @distractors);

#==========================================================
# SHUFFLE CHOICES (SEED-STABLE)
#==========================================================

my @choice_indices = (0 .. $#choices);
my @choice_shuffled = ();
while (@choice_indices) {
  my $pick = $local_random->random(0, $#choice_indices, 1);
  push @choice_shuffled, splice(@choice_indices, $pick, 1);
}
@choices = @choices[@choice_shuffled];

#==========================================================
# RADIO BUTTONS WITH A/B/C/D/E LABELS
#==========================================================

$rb = RadioButtons(
  [@choices],
  $correct,
  labels        => ['A','B','C','D','E'],
  displayLabels => 1,
  randomize     => 0,
  separator     => '<div style="margin-bottom: 0.7em;"></div>',
);

#==========================================================
# PGML
#==========================================================

BEGIN_PGML

[@ $mode eq "TRUE" ? "Which one of the following statements is <span style='color: #127663;'><strong>TRUE</strong></span> about $topic?" : "Which one of the following statements is <span style='color: #ba372a;'><strong>FALSE</strong></span> about $topic?" @]*

[_]{$rb}

END_PGML

ENDDOCUMENT();

