## DESCRIPTION
## Select the federal agency that corresponds to the given regulatory job.
## ENDDESCRIPTION
## KEYWORDS('US regulation of transgenic crops','federal agencies','regulatory jobs','which one','multiple choice')
## DBsubject('Biotechnology')
## DBchapter('')
## DBsection('')
## Date('2026-11-18')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserRadioButtons.pl',
    'PGcourse.pl',
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 0;

#==========================================================
# QUESTION DATA
#==========================================================

# All questions data
@questions_data = (
  {
    'item_name' => '<strong>looks at whether a crop could harm other plants or spread a plant pest</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #00775f; font-weight:700;">USDA APHIS</span>',
      '<span style="color: #c80085; font-weight:700;">EPA</span>',
      'CDC',
    ],
    'correct' => '<span style="color: #00775f; font-weight:700;">USDA APHIS</span>',
  },
  {
    'item_name' => '<strong>checks plant health risks before allowing field tests of crops that need a permit</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #00775f; font-weight:700;">USDA APHIS</span>',
      'NIH',
      'CDC',
    ],
    'correct' => '<span style="color: #00775f; font-weight:700;">USDA APHIS</span>',
  },
  {
    'item_name' => '<strong>reviews possible harm to plants when certain engineered crops are moved or grown</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #00775f; font-weight:700;">USDA APHIS</span>',
      'NIH',
      'CDC',
    ],
    'correct' => '<span style="color: #00775f; font-weight:700;">USDA APHIS</span>',
  },
  {
    'item_name' => '<strong>checks that food from an engineered crop meets the same food safety standards as other foods</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #003fff; font-weight:700;">FDA</span>',
      'NIH',
      'CDC',
    ],
    'correct' => '<span style="color: #003fff; font-weight:700;">FDA</span>',
  },
  {
    'item_name' => '<strong>looks at food and feed questions such as allergens and nutrients in a new food crop</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #00775f; font-weight:700;">USDA APHIS</span>',
      '<span style="color: #003fff; font-weight:700;">FDA</span>',
      'NIH',
    ],
    'correct' => '<span style="color: #003fff; font-weight:700;">FDA</span>',
  },
  {
    'item_name' => '<strong>reviews food safety information when a developer seeks a consultation for a new crop variety</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #003fff; font-weight:700;">FDA</span>',
      '<span style="color: #c80085; font-weight:700;">EPA</span>',
      'CDC',
    ],
    'correct' => '<span style="color: #003fff; font-weight:700;">FDA</span>',
  },
  {
    'item_name' => '<strong>reviews a substance made by Bt corn to protect it from insects</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #003fff; font-weight:700;">FDA</span>',
      '<span style="color: #c80085; font-weight:700;">EPA</span>',
      'CDC',
    ],
    'correct' => '<span style="color: #c80085; font-weight:700;">EPA</span>',
  },
  {
    'item_name' => '<strong>regulates pesticide substances that some crops make to protect themselves</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #003fff; font-weight:700;">FDA</span>',
      '<span style="color: #c80085; font-weight:700;">EPA</span>',
      'CDC',
    ],
    'correct' => '<span style="color: #c80085; font-weight:700;">EPA</span>',
  },
  {
    'item_name' => '<strong>checks possible harm to other organisms from an insect-killing substance made by a crop</strong>',
    'plural_choice' => 'federal agencies',
    'singular_item' => 'regulatory job',
    'choices' => [
      '<span style="color: #003fff; font-weight:700;">FDA</span>',
      '<span style="color: #c80085; font-weight:700;">EPA</span>',
      'CDC',
    ],
    'correct' => '<span style="color: #c80085; font-weight:700;">EPA</span>',
  },
);

#==========================================================
# SELECT RANDOM QUESTION
#==========================================================

my $local_random = PGrandom->new();
$local_random->srand($problemSeed);

$question_idx = $local_random->random(0, scalar(@questions_data) - 1, 1);
$q = $questions_data[$question_idx];

$item_name = $q->{'item_name'};
$plural_choice = $q->{'plural_choice'};
$singular_item = $q->{'singular_item'};
@choices = @{ $q->{'choices'} };
$correct = $q->{'correct'};

#==========================================================
# SHUFFLE CHOICES (SEED-STABLE)
#==========================================================

my @choice_indices = (0 .. $#choices);
my @choice_shuffled = ();
while (@choice_indices) {
  my $pick = $local_random->random(0, $#choice_indices, 1);
  push @choice_shuffled, splice(@choice_indices, $pick, 1);
}
@choices = @choices[@choice_shuffled];

#==========================================================
# BUILD RADIO BUTTONS
#==========================================================

$rb = RadioButtons(
  [@choices],
  $correct,
  labels        => 'ABC',
  displayLabels => 1,
  randomize     => 0,
  separator     => '<div style="margin-bottom: 0.7em;"></div>',
);

#==========================================================
# PGML
#==========================================================

BEGIN_PGML

Which one of the following [$plural_choice]* corresponds to the [$singular_item]* [$item_name]*?

[_]{$rb}

END_PGML

BEGIN_PGML_SOLUTION

The correct answer is: [$correct]*

END_PGML_SOLUTION

ENDDOCUMENT();

