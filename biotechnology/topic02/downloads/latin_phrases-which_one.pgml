    'choices' => [
      'in vivo',
      'in ovo',
      'ex vivo',
      'in petri',
      'in seed',
    ],
    'correct' => 'in vivo',
  },
  {
    'item_name' => '<strong>inside a test tube or Petri dish</strong>',
    'plural_choice' => 'Latin phrases',
    'singular_item' => 'meaning',
    'choices' => [
      'in situ',
      'in vitro',
      'in natura',
      'in ovo',
      'in petri',
    ],
    'correct' => 'in vitro',
  },
  {
    'item_name' => '<strong>in laboratory glassware</strong>',
    'plural_choice' => 'Latin phrases',
    'singular_item' => 'meaning',
    'choices' => [
      'in silico',
