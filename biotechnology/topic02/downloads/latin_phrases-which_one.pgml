    'plural_choice' => 'Latin phrases',
    'singular_item' => 'meaning',
    'choices' => [
      'in silico',
      'in vivo',
      'in simu',
      'in papyro',
      'in vacuo',
    ],
    'correct' => 'in silico',
  },
  {
    'item_name' => '<strong>in its original place</strong>',
    'plural_choice' => 'Latin phrases',
    'singular_item' => 'meaning',
    'choices' => [
      'in silico',
      'in situ',
      'in vitro',
