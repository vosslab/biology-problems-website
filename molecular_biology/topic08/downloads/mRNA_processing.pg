## TITLE('Post-transcriptional mRNA Modification')
## DESCRIPTION
## Select the statement that is TRUE or FALSE about post-transcriptional mRNA modification.
## ENDDESCRIPTION
## KEYWORDS('post-transcriptional mRNA modification','true/false','multiple choice')
## DBsubject('Molecular Biology')
## DBchapter('')
## DBsection('')
## Date('2026-08-19')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

#==========================================================
# AUTO-GENERATED GROUPS FROM YAML
#==========================================================

@true_groups = (
  [
    '<span style="color: #00802b; font-weight:700;">poly-adenine tail</span> is added on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
