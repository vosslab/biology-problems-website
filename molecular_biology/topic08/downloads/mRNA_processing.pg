    'a <span style="color: #4d4d00; font-weight:700;">modified guanosine</span> is placed on the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'a <span style="color: #4d4d00; font-weight:700;">modified guanosine</span> is added at the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'a <span style="color: #4d4d00; font-weight:700;">modified guanosine</span> is linked to the <span style="color: #86592d; font-weight:700;">first nucleotide</span>',
  ],
