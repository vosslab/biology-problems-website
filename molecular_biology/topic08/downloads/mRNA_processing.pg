    'coding sections are fused together',
    'coding sections are spliced together',
    'coding sections are joined together',
    'coding sections are stuck back together',
  ],
  [
    'nucleotide base modification',
    'RNA splicing',
  ],
);
@false_groups = (
  [
    '<span style="color: #4d4d00; font-weight:700;">poly-guanine tail</span> is added on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    '<span style="color: #4d4d00; font-weight:700;">poly-guanidinylation</span> at the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    'addition of a <span style="color: #008080; font-weight:700;">3&prime; end</span> <span style="color: #4d4d00; font-weight:700;">poly-guanidinylation</span>',
    'addition of a <span style="color: #4d4d00; font-weight:700;">poly-guanidinylation</span> tail on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    'addition of about 250 <span style="color: #4d4d00; font-weight:700;">guanine residues</span> on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    'about 250 <span style="color: #4d4d00; font-weight:700;">guanine residues</span> are added on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    '<span style="color: #00802b; font-weight:700;">poly-adenine tail</span> is added on the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    '<span style="color: #00802b; font-weight:700;">poly-adenylation</span> at the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'addition of a <span style="color: #86592d; font-weight:700;">5&prime; end</span> <span style="color: #00802b; font-weight:700;">poly-adenylation</span>',
    'addition of a <span style="color: #00802b; font-weight:700;">poly-adenylation</span> tail on the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'addition of about 250 <span style="color: #00802b; font-weight:700;">adenine residues</span> on the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'about 250 <span style="color: #00802b; font-weight:700;">adenine residues</span> are added on the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
  ],
  [
    'capping of <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    '<span style="color: #008080; font-weight:700;">3&prime; end</span> capping',
    'a cap is placed on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    'addition of a cap on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    'a <span style="color: #00802b; font-weight:700;">modified adenosine</span> is linked to the <span style="color: #86592d; font-weight:700;">first nucleotide</span>',
    'a <span style="color: #00802b; font-weight:700;">modified adenosine</span> is linked to the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'a <span style="color: #00802b; font-weight:700;">modified adenosine</span> is placed on the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'a <span style="color: #00802b; font-weight:700;">modified adenosine</span> is added at the <span style="color: #86592d; font-weight:700;">5&prime; end</span>',
    'a <span style="color: #4d4d00; font-weight:700;">modified guanosine</span> is linked to the <span style="color: #008080; font-weight:700;">last nucleotide</span>',
    'a <span style="color: #4d4d00; font-weight:700;">modified guanosine</span> is linked to the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    'a <span style="color: #4d4d00; font-weight:700;">modified guanosine</span> is placed on the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
    'a <span style="color: #4d4d00; font-weight:700;">modified guanosine</span> is added at the <span style="color: #008080; font-weight:700;">3&prime; end</span>',
  ],
  [
    'removal the intervening,<span style="color: #0000b3; font-weight:700;"> coding</span> sequences',
    'removal of <span style="color: #0000b3; font-weight:700;">exons</span>',
    'removing internal<span style="color: #0000b3; font-weight:700;"> coding</span> RNA sequences',
    'coding sections of the RNA are removed',
    '<span style="color: #0000b3; font-weight:700;">exons</span> of the RNA are removed',
    '<span style="color: #b30059; font-weight:700;">introns</span> are fused together',
    '<span style="color: #b30059; font-weight:700;">introns</span> are spliced together',
    '<span style="color: #b30059; font-weight:700;">introns</span> are joined together',
    '<span style="color: #b30059; font-weight:700;">introns</span> are stuck back together',
    '<span style="color: #b30059; font-weight:700;">non-coding</span> sections are fused together',
    '<span style="color: #b30059; font-weight:700;">non-coding</span> sections are spliced together',
    '<span style="color: #b30059; font-weight:700;">non-coding</span> sections are joined together',
    '<span style="color: #b30059; font-weight:700;">non-coding</span> sections are stuck back together',
  ],
  [
    'reverse transcription of the mRNA',
    'mRNA proofreading',
  ],
);

#==========================================================
# GLOBAL SETTINGS
#==========================================================

$topic = 'post-transcriptional mRNA modification';
my $local_random = PGrandom->new();
$local_random->srand($problemSeed);
my @mode_choices = ("TRUE", "FALSE");
$mode = $mode_choices[$local_random->random(0, $#mode_choices, 1)];
$num_distractors = 4;
#==========================================================
# SELECT GROUP
#==========================================================

my (@selected_group, @opposite_groups);

if ($mode eq "TRUE") {
  $group_index      = $local_random->random(0, scalar(@true_groups)-1, 1);
  @selected_group   = @{ $true_groups[$group_index] };
  @opposite_groups  = @false_groups;
} else {
  $group_index      = $local_random->random(0, scalar(@false_groups)-1, 1);
  @selected_group   = @{ $false_groups[$group_index] };
  @opposite_groups  = @true_groups;
}

#==========================================================
# PICK CORRECT + DISTRACTORS
#==========================================================

my $correct_index = $local_random->random(0, $#selected_group, 1);
$correct = $selected_group[$correct_index];

my @available_group_indices = (0 .. $#opposite_groups);
my @selected_distractor_indices = ();

while (@selected_distractor_indices < $num_distractors && @available_group_indices > 0) {
  my $random_index = $local_random->random(0, scalar(@available_group_indices)-1, 1);
  push @selected_distractor_indices, splice(@available_group_indices, $random_index, 1);
}

@distractors = ();
foreach my $group_idx (@selected_distractor_indices) {
  my @group = @{ $opposite_groups[$group_idx] };
  my $distractor_index = $local_random->random(0, $#group, 1);
  my $distractor = $group[$distractor_index];
  push @distractors, $distractor;
}

@choices = ($correct, @distractors);

#==========================================================
# SHUFFLE CHOICES (SEED-STABLE)
#==========================================================

my @choice_indices = (0 .. $#choices);
my @choice_shuffled = ();
while (@choice_indices) {
  my $pick = $local_random->random(0, $#choice_indices, 1);
  push @choice_shuffled, splice(@choice_indices, $pick, 1);
}
@choices = @choices[@choice_shuffled];

#==========================================================
# RADIO BUTTONS WITH A/B/C/D/E LABELS
#==========================================================

$rb = RadioButtons(
  [@choices],
  $correct,
  labels        => ['A','B','C','D','E'],
  displayLabels => 1,
  randomize     => 0,
  separator     => '<div style="margin-bottom: 0.7em;"></div>',
);

#==========================================================
# PGML
#==========================================================

BEGIN_PGML

[@ $mode eq "TRUE" ? "Which one of the following statements is <span style='color: #127663;'><strong>TRUE</strong></span> about $topic?" : "Which one of the following statements is <span style='color: #ba372a;'><strong>FALSE</strong></span> about $topic?" @]*

[_]{$rb}

END_PGML

ENDDOCUMENT();

