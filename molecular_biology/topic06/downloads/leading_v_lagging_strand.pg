## TITLE('Difference Between the Leading Strand and the Lagging Strand in DNA Replication')
## DESCRIPTION
## Select the statement that is TRUE or FALSE about difference between the leading strand and the lagging strand in DNA replication.
## ENDDESCRIPTION
## KEYWORDS('difference between the leading strand and the lagging strand in DNA replication','true/false','multiple choice')
## DBsubject('Molecular Biology')
## DBchapter('')
## DBsection('')
## Date('2026-08-19')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

