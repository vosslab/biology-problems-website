    'the <span style="color: #995c00; font-weight:700;">lagging strand</span> is synthesized in the 3&prime;&rarr;5&prime; direction of the template strand,<br/> while the <span style="color: #002699; font-weight:700;">leading strand</span> is synthesized in the 5&prime;&rarr;3&prime; direction of the template strand',
    'both the the <span style="color: #002699; font-weight:700;">leading strand</span> and the <span style="color: #995c00; font-weight:700;">lagging strand</span> are synthesized in the 3&prime;&rarr;5&prime; direction of the template strand',
  ],
  [
    'the <span style="color: #002699; font-weight:700;">leading strand</span> requires <span style="color: #b33000; font-weight:700;">RNA primers</span>, whereas the <span style="color: #995c00; font-weight:700;">lagging strand</span> does not',
    'the <span style="color: #995c00; font-weight:700;">lagging strand</span> requires <span style="color: #b33000; font-weight:700;">RNA primers</span>, whereas the <span style="color: #002699; font-weight:700;">leading strand</span> does not',
    'the <span style="color: #002699; font-weight:700;">leading strand</span> requires <span style="color: #248f24; font-weight:700;">DNA primers</span>, whereas the <span style="color: #995c00; font-weight:700;">lagging strand</span> does not',
    'the <span style="color: #995c00; font-weight:700;">lagging strand</span> requires <span style="color: #248f24; font-weight:700;">DNA primers</span>, whereas the <span style="color: #002699; font-weight:700;">leading strand</span> does not',
